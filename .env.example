# Copy to .env.local for local testing. On Vercel set these in Project → Settings → Environment Variables.
# Without SMTP settings, local `npm run dev` prints enquiries to the terminal; production shows "please call us".

# SMTP server that sends the enquiry emails. Gmail: smtp.gmail.com, port 465, your Gmail address, and an
# App Password (Google Account → Security → 2-Step Verification → App passwords), not your normal password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where enquiries go (default m.goyal543@gmail.com) and the sender address (default SMTP_USER)
ENQUIRY_TO=
ENQUIRY_FROM=
